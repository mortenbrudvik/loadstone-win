<ui:FluentWindow
    x:Class="Loadstone.UI.Views.SettingsWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Loadstone.UI.Controls"
    xmlns:views="clr-namespace:Loadstone.UI.Views"
    xmlns:vm="clr-namespace:Loadstone.UI.ViewModels"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="Loadstone Settings"
    Icon="pack://application:,,,/Loadstone;component/Assets/loadstone.ico"
    Width="520"
    Height="560"
    MinWidth="480"
    MinHeight="480"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True">

  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <views:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    <!-- Each caption is also its switch's help text for assistive technology, so one string serves both and they cannot drift apart. -->
    <sys:String x:Key="DragSnappingCaption">Turning this on switches off Windows' own drag-to-edge snapping while Loadstone runs, so the two do not fight. It comes back when you turn this off, when Loadstone quits, or when you sign out.</sys:String>
    <sys:String x:Key="RestoreOneMoveCaption">Off, Restore (Ctrl+Alt+Backspace by default) jumps back to where the window was before Loadstone first moved it. On, each press steps back one move — hotkey or drag snap — until that original spot.</sys:String>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The maximize box itself is removed from the window style in OnSourceInitialized; these two only cover the button. -->
    <ui:TitleBar x:Name="SettingsTitleBar" Grid.Row="0" Title="Loadstone Settings" ShowMaximize="False" CanMaximize="False" />

    <TabControl Grid.Row="1" Margin="16,8,16,16">

      <TabItem Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding General}" Margin="0,12,0,0">

            <ui:TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                FontTypography="Caption"
                TextWrapping="Wrap"
                Text="{Binding SettingsFileMessage}"
                Visibility="{Binding SettingsFileMessage, Converter={StaticResource StringToVisibilityConverter}}" />

            <ui:Card Margin="0,0,0,12">
              <StackPanel>
                <ui:ToggleSwitch
                    Content="Snap windows by dragging to screen edges"
                    IsChecked="{Binding DragSnappingEnabled}"
                    AutomationProperties.HelpText="{StaticResource DragSnappingCaption}" />
                <ui:TextBlock
                    Margin="0,8,0,0"
                    Appearance="Secondary"
                    FontTypography="Caption"
                    TextWrapping="Wrap"
                    Text="{StaticResource DragSnappingCaption}" />
              </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
              <StackPanel>
                <ui:ToggleSwitch
                    Content="Restore one move at a time"
                    IsChecked="{Binding RestoreOneMoveAtATime}"
                    AutomationProperties.HelpText="{StaticResource RestoreOneMoveCaption}" />
                <ui:TextBlock
                    Margin="0,8,0,0"
                    Appearance="Secondary"
                    FontTypography="Caption"
                    TextWrapping="Wrap"
                    Text="{StaticResource RestoreOneMoveCaption}" />
              </StackPanel>
            </ui:Card>

            <ui:Card>
              <StackPanel>
                <!-- Disabled, not merely explained, while a policy decides it: the write would be refused and the switch would snap back. -->
                <ui:ToggleSwitch
                    Content="Launch at login"
                    IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}"
                    IsEnabled="{Binding CanChangeLaunchAtLogin}"
                    Command="{Binding SetLaunchAtLoginCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                    AutomationProperties.HelpText="{Binding LaunchAtLoginMessage}" />
                <!-- The margins are on the two children, and the caption collapses when it is empty: with
                     neither showing, which is the ordinary case, the row takes no room in the card. -->
                <DockPanel>
                  <ui:Button
                      DockPanel.Dock="Right"
                      Margin="8,8,0,0"
                      Content="Open Startup Apps"
                      Command="{Binding OpenStartupAppsCommand}"
                      Visibility="{Binding ShowOpenStartupApps, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <ui:TextBlock
                      Margin="0,8,0,0"
                      VerticalAlignment="Center"
                      Appearance="Secondary"
                      FontTypography="Caption"
                      TextWrapping="Wrap"
                      AutomationProperties.LiveSetting="Polite"
                      Text="{Binding LaunchAtLoginMessage}"
                      Visibility="{Binding LaunchAtLoginMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                </DockPanel>
                <ui:TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    FontTypography="Caption"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{Binding ShellActionMessage}"
                    Visibility="{Binding ShellActionMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                <ui:TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    FontTypography="Caption"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{Binding LaunchAtLoginActionMessage}"
                    Visibility="{Binding LaunchAtLoginActionMessage, Converter={StaticResource StringToVisibilityConverter}}" />
              </StackPanel>
            </ui:Card>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Shortcuts">
        <!-- A grid rather than a dock panel, so the scroll viewer can be declared before the button that sits
             below it: tab order follows the tree, and a reset button declared first was the tab's first stop. -->
        <Grid DataContext="{Binding Shortcuts}" Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- WPF-UI paints the bar over the content (ColumnSpan=2, 14px). Keep the recorders out of that strip. -->
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ShortcutGroupViewModel}">
                  <StackPanel Margin="0,0,0,16">
                    <ui:TextBlock Margin="0,0,0,6" FontTypography="BodyStrong" Text="{Binding Header}" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ShortcutRowViewModel}">
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                              <ui:TextBlock Text="{Binding Title}" />
                              <ui:TextBlock
                                  Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                  FontTypography="Caption"
                                  TextWrapping="Wrap"
                                  AutomationProperties.LiveSetting="Polite"
                                  Text="{Binding Status}"
                                  Visibility="{Binding Status, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                            <controls:ShortcutRecorder
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                AutomationProperties.Name="{Binding Title}"
                                Shortcut="{Binding Shortcut, Mode=TwoWay}"
                                IsRecording="{Binding IsRecording, Mode=TwoWay}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <ui:Button
              Grid.Row="1"
              Margin="0,12,16,0"
              HorizontalAlignment="Right"
              Content="Restore defaults"
              Command="{Binding RestoreDefaultsCommand}" />
        </Grid>
      </TabItem>

      <TabItem Header="About">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding About}" Margin="0,12,0,0">

            <!-- The desktop in miniature. Its caption is a live region: it says what each press or drop did. -->
            <controls:MiniDesktop x:Name="AboutDesktop" />
            <ui:TextBlock
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                Appearance="Secondary"
                FontTypography="Caption"
                TextWrapping="Wrap"
                TextAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Text="{Binding Status, ElementName=AboutDesktop}" />

            <ui:TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontTypography="Title" Text="Loadstone" />
            <ui:TextBlock
                Margin="0,2,0,0"
                MaxWidth="420"
                HorizontalAlignment="Center"
                Appearance="Secondary"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Text="A loadstone is a naturally magnetic stone, the kind the first compasses were made from. This one pulls windows into place." />

            <!-- The two things a bug report needs, side by side. The middle column holds the buttons and
                 the outer two are equal, so "Copied" appearing beside them does not push them sideways. -->
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button
                    Content="{Binding VersionLabel}"
                    Command="{Binding CopyVersionCommand}"
                    ToolTip="Copy the version"
                    AutomationProperties.HelpText="Copies the version" />
                <ui:Button Margin="6,0,0,0" Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
              </StackPanel>
              <ui:TextBlock
                  Grid.Column="2"
                  Margin="10,0,0,0"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                  FontTypography="Caption"
                  AutomationProperties.LiveSetting="Polite"
                  Text="{Binding CopyMessage}"
                  Visibility="{Binding CopyMessage, Converter={StaticResource StringToVisibilityConverter}}" />
            </Grid>

            <!-- In reading order, and a wrap panel so a narrow window gets a second row and not a clipped button. -->
            <WrapPanel Margin="0,3,0,0" HorizontalAlignment="Center">
              <ui:Button Margin="3" Content="Source code" Command="{Binding OpenSourceCodeCommand}" />
              <ui:Button Margin="3" Content="Report a problem" Command="{Binding ReportProblemCommand}" />
              <ui:Button Margin="3" Content="Rate in the Store" Command="{Binding RateInStoreCommand}" />
            </WrapPanel>
            <ui:TextBlock
                Margin="0,6,0,0"
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                FontTypography="Caption"
                TextWrapping="Wrap"
                TextAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Text="{Binding Message}"
                Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}" />

            <ui:TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Appearance="Tertiary"
                FontTypography="Caption"
                TextWrapping="Wrap"
                TextAlignment="Center">
              <Run Text="{Binding Copyright, Mode=OneWay}" /><Run Text="  &#x00B7;  MIT License  &#x00B7;  " /><Hyperlink Command="{Binding OpenHomepageCommand}" ToolTip="https://brudvik.com">brudvik.com</Hyperlink><Run Text="  &#x00B7;  " /><Hyperlink Command="{Binding OpenMacAppCommand}">Also for macOS</Hyperlink>
            </ui:TextBlock>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <!-- Last, so it paints over everything above when a dialog is up. Registered on the dialog service in the constructor. -->
    <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="2" />
  </Grid>

</ui:FluentWindow>
