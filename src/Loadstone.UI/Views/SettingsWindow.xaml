<ui:FluentWindow
    x:Class="Loadstone.UI.Views.SettingsWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Loadstone.UI.Controls"
    xmlns:views="clr-namespace:Loadstone.UI.Views"
    xmlns:vm="clr-namespace:Loadstone.UI.ViewModels"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="Loadstone Settings"
    Icon="pack://application:,,,/Loadstone;component/Assets/loadstone.ico"
    Width="520"
    Height="560"
    MinWidth="480"
    MinHeight="480"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True">

  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <views:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    <!-- Each caption is also its switch's help text for assistive technology, so one string serves both and they cannot drift apart. -->
    <sys:String x:Key="DragSnappingCaption">Turning this on switches off Windows' own drag-to-edge snapping while Loadstone runs, so the two do not fight. It comes back when you turn this off, when Loadstone quits, or when you sign out.</sys:String>
    <sys:String x:Key="RestoreOneMoveCaption">Off, Restore (Ctrl+Alt+Backspace by default) jumps back to where the window was before Loadstone first moved it. On, each press steps back one move — hotkey or drag snap — until that original spot.</sys:String>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The maximize box itself is removed from the window style in OnSourceInitialized; these two only cover the button. -->
    <ui:TitleBar x:Name="SettingsTitleBar" Grid.Row="0" Title="Loadstone Settings" ShowMaximize="False" CanMaximize="False" />

    <TabControl Grid.Row="1" Margin="16,8,16,16">

      <TabItem Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding General}" Margin="0,12,0,0">

            <ui:TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                FontTypography="Caption"
                TextWrapping="Wrap"
                Text="{Binding SettingsFileMessage}"
                Visibility="{Binding SettingsFileMessage, Converter={StaticResource StringToVisibilityConverter}}" />

            <ui:Card Margin="0,0,0,12">
              <StackPanel>
                <ui:ToggleSwitch
                    Content="Snap windows by dragging to screen edges"
                    IsChecked="{Binding DragSnappingEnabled}"
                    AutomationProperties.HelpText="{StaticResource DragSnappingCaption}" />
                <ui:TextBlock
                    Margin="0,8,0,0"
                    Appearance="Secondary"
                    FontTypography="Caption"
                    TextWrapping="Wrap"
                    Text="{StaticResource DragSnappingCaption}" />
              </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
              <StackPanel>
                <ui:ToggleSwitch
                    Content="Restore one move at a time"
                    IsChecked="{Binding RestoreOneMoveAtATime}"
                    AutomationProperties.HelpText="{StaticResource RestoreOneMoveCaption}" />
                <ui:TextBlock
                    Margin="0,8,0,0"
                    Appearance="Secondary"
                    FontTypography="Caption"
                    TextWrapping="Wrap"
                    Text="{StaticResource RestoreOneMoveCaption}" />
              </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12">
              <StackPanel>
                <!-- Disabled, not merely explained, while a policy decides it: the write would be refused and the switch would snap back. -->
                <ui:ToggleSwitch
                    Content="Launch at login"
                    IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}"
                    IsEnabled="{Binding CanChangeLaunchAtLogin}"
                    Command="{Binding SetLaunchAtLoginCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                    AutomationProperties.HelpText="{Binding LaunchAtLoginMessage}" />
                <DockPanel Margin="0,8,0,0">
                  <!-- One panel for both buttons, in reading order: tab order follows the tree, and two
                       buttons each docked right were tabbed right to left and sat flush when both showed. -->
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <ui:Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="Open Startup Apps"
                        Command="{Binding OpenStartupAppsCommand}"
                        Visibility="{Binding ShowOpenStartupApps, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </StackPanel>
                  <ui:TextBlock
                      VerticalAlignment="Center"
                      Appearance="Secondary"
                      FontTypography="Caption"
                      TextWrapping="Wrap"
                      AutomationProperties.LiveSetting="Polite"
                      Text="{Binding LaunchAtLoginMessage}" />
                </DockPanel>
                <ui:TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    FontTypography="Caption"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{Binding ShellActionMessage}"
                    Visibility="{Binding ShellActionMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                <ui:TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    FontTypography="Caption"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{Binding LaunchAtLoginActionMessage}"
                    Visibility="{Binding LaunchAtLoginActionMessage, Converter={StaticResource StringToVisibilityConverter}}" />
              </StackPanel>
            </ui:Card>

            <ui:Card>
              <StackPanel>
                <ui:TextBlock FontTypography="BodyStrong" Text="About" />
                <ui:TextBlock Margin="0,4,0,0" Text="Loadstone" />
                <ui:TextBlock Appearance="Secondary" Text="{Binding Version, StringFormat='Version {0}'}" />
              </StackPanel>
            </ui:Card>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Shortcuts">
        <!-- A grid rather than a dock panel, so the scroll viewer can be declared before the button that sits
             below it: tab order follows the tree, and a reset button declared first was the tab's first stop. -->
        <Grid DataContext="{Binding Shortcuts}" Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- WPF-UI paints the bar over the content (ColumnSpan=2, 14px). Keep the recorders out of that strip. -->
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ShortcutGroupViewModel}">
                  <StackPanel Margin="0,0,0,16">
                    <ui:TextBlock Margin="0,0,0,6" FontTypography="BodyStrong" Text="{Binding Header}" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ShortcutRowViewModel}">
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                              <ui:TextBlock Text="{Binding Title}" />
                              <ui:TextBlock
                                  Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                  FontTypography="Caption"
                                  TextWrapping="Wrap"
                                  AutomationProperties.LiveSetting="Polite"
                                  Text="{Binding Status}"
                                  Visibility="{Binding Status, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                            <controls:ShortcutRecorder
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                AutomationProperties.Name="{Binding Title}"
                                Shortcut="{Binding Shortcut, Mode=TwoWay}"
                                IsRecording="{Binding IsRecording, Mode=TwoWay}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <ui:Button
              Grid.Row="1"
              Margin="0,12,16,0"
              HorizontalAlignment="Right"
              Content="Restore defaults"
              Command="{Binding RestoreDefaultsCommand}" />
        </Grid>
      </TabItem>

    </TabControl>

    <!-- Last, so it paints over everything above when a dialog is up. Registered on the dialog service in the constructor. -->
    <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="2" />
  </Grid>

</ui:FluentWindow>
