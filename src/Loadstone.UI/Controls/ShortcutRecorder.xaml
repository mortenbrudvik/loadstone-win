<UserControl
    x:Class="Loadstone.UI.Controls.ShortcutRecorder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Focusable="True"
    MinWidth="180"
    Height="32"
    AutomationProperties.Name="Shortcut"
    AutomationProperties.HelpText="Press a key combination to set the shortcut. Escape cancels, Backspace clears.">

  <Border
      x:Name="Outline"
      Background="{DynamicResource ControlFillColorDefaultBrush}"
      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="4">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock
          x:Name="Text"
          Grid.Column="0"
          Margin="10,0,4,0"
          VerticalAlignment="Center"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
          AutomationProperties.LiveSetting="Polite" />

      <!-- 28 px each way inside the 32 px control (1 px border, 1 px margin): the guide's minimum pointer target. -->
      <ui:Button
          x:Name="ClearButton"
          Grid.Column="1"
          Margin="1"
          Padding="4,0"
          MinWidth="28"
          MinHeight="28"
          Appearance="Transparent"
          Icon="{ui:SymbolIcon Dismiss16}"
          ToolTip="Clear"
          AutomationProperties.Name="Clear shortcut"
          Focusable="False"
          Click="OnClearClick" />
    </Grid>
  </Border>

</UserControl>
