<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Xunit.StaFact" Version="4.0.23" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Loadstone.UI\Loadstone.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One settings fake for both test projects; the two copies had already diverged. The linked
         file keeps its Core.Tests namespace, which the global using makes visible here. -->
    <Compile Include="..\Loadstone.Core.Tests\Settings\InMemorySettings.cs" Link="InMemorySettings.cs" />
    <Using Include="Loadstone.Core.Tests.Settings" />
  </ItemGroup>

</Project>
